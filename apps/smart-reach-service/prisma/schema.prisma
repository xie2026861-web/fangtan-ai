// Prisma Schema for Smart Reach Service
// 房探AI - 智能触达服务数据模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 外呼任务状态
enum CallTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

// 外呼任务
model CallTask {
  id              String           @id @default(uuid())
  name            String           // 任务名称
  description     String?          // 任务描述
  scriptId        String?          // 外呼话术ID
  customerIds     String[]         // 客户ID列表
  totalCustomers Int              // 客户总数
  completedCalls  Int              @default(0) // 已完成数量
  successfulCalls Int             @default(0) // 成功数量(接通)
  failedCalls     Int             @default(0) // 失败数量
  status          CallTaskStatus  @default(PENDING)
  priority        Int              @default(1)
  scheduledAt     DateTime?       // 计划执行时间
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([status])
  @@index([scheduledAt])
}

// 外呼记录
model CallRecord {
  id            String   @id @default(uuid())
  taskId        String   // 任务ID
  customerId    String   // 客户ID
  customerPhone String   // 客户电话
  status        String   // 状态: 拨打中, 已接通, 未接通, 通话中, 已完成
  duration      Int      @default(0) // 通话时长(秒)
  recordingUrl  String?  // 录音URL
  transcript    String?  // 通话记录
  aiSummary     String?  // AI总结
  intent        String?  // 客户意向: 有意向, 无意向, 待跟进
  followUp      String?  // 跟进建议
  errorMessage  String?
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  
  @@index([taskId])
  @@index([customerId])
  @@index([status])
  @@index([startedAt])
}

// 外呼话术模板
model CallScript {
  id          String   @id @default(uuid())
  name        String   // 话术名称
  description String?  // 话术描述
  content     String   // 话术内容(支持变量替换)
  type        String   // 类型: 开场白, 介绍, 挽留, 结束语
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive])
}

// 短信模板
model SmsTemplate {
  id          String   @id @default(uuid())
  name        String   // 模板名称
  content     String   // 短信内容
  variables   String[] // 变量列表
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive])
}

// 触达记录
model TouchRecord {
  id            String   @id @default(uuid())
  customerId    String   // 客户ID
  type          String   // 触达类型: call, sms, wechat
  templateId    String?  // 模板ID
  content       String   // 发送内容
  status        String   // 状态: pending, sent, delivered, failed
  response      Json?    // 发送响应
  sentAt        DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
  
  @@index([customerId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}
