# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fangtan_ai?schema=public"

# JWT
JWT_SECRET="fangtan-ai-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL="debug"
