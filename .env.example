# 房探AI - 环境配置模板
# 复制此文件为 .env 并修改配置

# ============ 数据库配置 ============
DATABASE_URL="postgresql://fangtan:fangtan_password@localhost:5432/fangtan_dev"
REDIS_URL="redis://:fangtan_redis_password@localhost:6379"
MONGODB_URL="mongodb://admin:fangtan_mongo_password@localhost:27017/fangtan"
ELASTICSEARCH_URL="http://localhost:9200"
CLICKHOUSE_URL="http://localhost:8123"

# ============ JWT配置 ============
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# ============ API Keys ============
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# ============ 第三方服务 ============
AMAP_KEY="your-amap-key"
WECHAT_CORP_ID="your-corp-id"
WECHAT_AGENT_SECRET="your-agent-secret"

# ============ MinIO配置 ============
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ROOT_USER="fangtan_minio_admin"
MINIO_ROOT_PASSWORD="fangtan_minio_password"

# ============ Kafka配置 ============
KAFKA_BROKERS="localhost:9092"
KAFKA_USERNAME=""
KAFKA_PASSWORD=""

# ============ 功能开关 ============
ENABLE_MOCK_DATA="false"
LOG_LEVEL="info"
NODE_ENV="development"

# ============ 端口配置 ============
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ============ 安全配置 ============
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============ Docker镜像仓库 ============
DOCKER_REGISTRY="docker.io"
DOCKER_USERNAME=""
DOCKER_PASSWORD=""
DOCKER_IMAGE_PREFIX="fangtan-ai"

# ============ 监控配置 ============
SENTRY_DSN=""
PROMETHEUS_ENABLED="true"

# ============ 邮件配置 ============
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="noreply@fangtan.ai"

# ============ 支付配置 ============
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
