# 房探AI生产环境环境变量配置
# 复制此文件为 .env.production 并修改配置

# ============ 镜像配置 ============
DOCKER_REGISTRY=registry.cn-hangzhou.aliyuncs.com
IMAGE_TAG=latest

# ============ 域名配置 ============
NEXT_PUBLIC_API_URL=https://api.fangtan.ai
NEXT_PUBLIC_APP_URL=https://fangtan.ai
CORS_ORIGIN=https://fangtan.ai,https://www.fangtan.ai

# ============ 数据库配置（阿里云RDS PostgreSQL） ============
DB_HOST=rm-bp1xxxxxxxxxxxxx.pg.rds.aliyuncs.com
DB_PORT=5432
DB_USERNAME=fangtan
DB_PASSWORD=your_secure_rds_password
DB_NAME=fangtan_prod

# ============ Redis配置（阿里云Redis） ============
REDIS_HOST=r-bp1xxxxxxxxxxxxx.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# ============ MongoDB配置（阿里云MongoDB） ============
MONGO_HOST=dds-bp1xxxxxxxxxxxxx.mongodb.rds.aliyuncs.com
MONGO_PORT=3717
MONGO_USERNAME=fangtan
MONGO_PASSWORD=your_secure_mongo_password
MONGO_DB=fangtan

# ============ Elasticsearch配置 ============
ES_HOST=es-cn-xxxxxxxxxxxxx.elasticsearch.aliyuncs.com
ES_PORT=9200

# ============ Kafka配置 ============
KAFKA_BROKERS=10.96.0.1:9092

# ============ JWT配置 ============
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ============ API Keys ============
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ============ 第三方服务 ============
AMAP_KEY=your-amap-key
WECHAT_CORP_ID=your-corp-id
WECHAT_AGENT_SECRET=your-agent-secret

# ============ 支付配置 ============
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ============ 邮件配置 ============
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@fangtan.ai
SMTP_PASSWORD=your-email-password
FROM_EMAIL=noreply@fangtan.ai

# ============ 监控配置 ============
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# ============ 日志配置 ============
LOG_LEVEL=info
LOG_FORMAT=json

# ============ 性能配置 ============
NODE_OPTIONS=--max-old-space-size=2048
WORKER_CONCURRENCY=4
